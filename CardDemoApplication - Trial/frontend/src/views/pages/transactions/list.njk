{% extends "layouts/base.njk" %}
{% from "components/back-link/macro.njk" import govukBackLink %}
{% from "components/button/macro.njk"    import govukButton %}
{% from "components/pagination/macro.njk" import govukPagination %}

{% block backLink %}
  {% if accountId %}
    {{ govukBackLink({ text: "Back to account inquiry", href: "/accounts/inquiry" }) }}
  {% else %}
    {{ govukBackLink({ text: "Back to menu", href: "/menu" }) }}
  {% endif %}
{% endblock %}

{% block content %}

<span class="cd-page-caption">Transaction Management</span>
<h1 class="govuk-heading-l">Transactions</h1>

{% if accountId %}
<div class="govuk-inset-text govuk-!-margin-bottom-4">
  Showing transactions for account <strong class="cd-mono">{{ accountId }}</strong>
</div>
{% endif %}

<div class="cd-action-group govuk-!-margin-bottom-4">
  {{ govukButton({ text: "Add Transaction", href: "/transactions/add" }) }}
</div>

{% if data and data.items.length %}
<div class="cd-table-wrapper">
  <table class="govuk-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th class="govuk-table__header">Transaction ID</th>
        <th class="govuk-table__header">Date</th>
        <th class="govuk-table__header">Description</th>
        <th class="govuk-table__header">Type</th>
        <th class="govuk-table__header govuk-table__header--numeric">Amount</th>
        <th class="govuk-table__header">Actions</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for txn in data.items %}
      <tr class="govuk-table__row">
        <td class="govuk-table__cell cd-mono">{{ txn.transactionId }}</td>
        <td class="govuk-table__cell">{{ txn.date | formatDate }}</td>
        <td class="govuk-table__cell">{{ txn.description }}</td>
        <td class="govuk-table__cell">
          <strong class="govuk-tag govuk-tag--{% if txn.transactionType == 'PAYMENT' or txn.transactionType == 'REFUND' %}green{% elif txn.transactionType == 'PURCHASE' %}blue{% else %}grey{% endif %}">
            {{ txn.transactionType }}
          </strong>
        </td>
        <td class="govuk-table__cell govuk-table__cell--numeric">{{ txn.amount | currency }}</td>
        <td class="govuk-table__cell cd-table-actions">
          <a href="/transactions/{{ txn.transactionId }}" class="govuk-link">Detail</a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% if data.pagination %}
  {% set prevHref = ("?page=" + (data.pagination.page - 1) + ("&accountId=" + accountId if accountId)) if data.pagination.hasPrevious %}
  {% set nextHref = ("?page=" + (data.pagination.page + 1) + ("&accountId=" + accountId if accountId)) if data.pagination.hasNext %}
  {{ govukPagination({
    previous: { href: prevHref } if data.pagination.hasPrevious,
    next:     { href: nextHref } if data.pagination.hasNext,
    landmarkLabel: "Transaction results"
  }) }}
{% endif %}

{% else %}
<div class="govuk-inset-text">No transactions found.</div>
{% endif %}

{% endblock %}
