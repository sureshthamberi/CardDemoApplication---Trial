{% extends "layouts/base.njk" %}
{% from "components/back-link/macro.njk"     import govukBackLink %}
{% from "components/input/macro.njk"         import govukInput %}
{% from "components/radios/macro.njk"        import govukRadios %}
{% from "components/date-input/macro.njk"    import govukDateInput %}
{% from "components/button/macro.njk"        import govukButton %}
{% from "components/error-summary/macro.njk" import govukErrorSummary %}

{% block backLink %}
  {{ govukBackLink({ text: "Back to card search", href: "/cards/search" }) }}
{% endblock %}

{% block content %}

<span class="cd-page-caption">Card Management</span>
<h1 class="govuk-heading-l">Update Card</h1>

{% if errors %}
  {{ govukErrorSummary({ titleText: "There is a problem", errorList: errors }) }}
{% endif %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <div class="govuk-inset-text">
      Card <strong class="cd-mono">{{ card.cardNumberMasked }}</strong> &mdash; Account <strong class="cd-mono">{{ card.accountId }}</strong>
    </div>

    <form action="/cards/{{ card.cardNumber }}/edit" method="post" novalidate>
      <input type="hidden" name="accountId"  value="{{ card.accountId }}">
      <input type="hidden" name="rowVersion" value="{{ card.rowVersion }}">

      {{ govukInput({
        label: { text: "Card Name", classes: "govuk-label--s" },
        hint: { text: "Letters and spaces only" },
        id: "cardName",
        name: "cardName",
        classes: "govuk-input--width-20",
        value: card.cardName,
        attributes: { pattern: "[A-Za-z ]+", required: "", maxlength: "100" }
      }) }}

      {{ govukRadios({
        name: "activeStatus",
        fieldset: { legend: { text: "Active Status", classes: "govuk-fieldset__legend--s" } },
        value: card.activeStatus,
        classes: "govuk-radios--inline",
        items: [
          { value: "Y", text: "Active" },
          { value: "N", text: "Inactive" }
        ]
      }) }}

      {{ govukDateInput({
        id: "expiry",
        namePrefix: "expiry",
        fieldset: { legend: { text: "Expiry Date", classes: "govuk-fieldset__legend--s" } },
        hint: { text: "For example, 3 2028" },
        items: [
          {
            name: "month",
            id: "expiry-month",
            label: { text: "Month" },
            classes: "govuk-input--width-2",
            value: card.expiryMonth,
            attributes: { min: "1", max: "12" }
          },
          {
            name: "year",
            id: "expiry-year",
            label: { text: "Year" },
            classes: "govuk-input--width-4",
            value: card.expiryYear,
            attributes: { min: "2020", max: "2099" }
          }
        ]
      }) }}

      <div class="cd-action-group">
        {{ govukButton({ text: "Save Changes" }) }}
        <a href="/cards/search" class="govuk-link">Cancel</a>
      </div>
    </form>
  </div>
</div>

{% endblock %}
