{% extends "layouts/base.njk" %}
{% from "components/back-link/macro.njk"     import govukBackLink %}
{% from "components/input/macro.njk"         import govukInput %}
{% from "components/select/macro.njk"        import govukSelect %}
{% from "components/radios/macro.njk"        import govukRadios %}
{% from "components/button/macro.njk"        import govukButton %}
{% from "components/error-summary/macro.njk" import govukErrorSummary %}
{% from "components/date-input/macro.njk"    import govukDateInput %}

{% block backLink %}
  {{ govukBackLink({ text: "Back to account inquiry", href: "/accounts/inquiry" }) }}
{% endblock %}

{% block content %}

<span class="cd-page-caption">Account Management</span>
<h1 class="govuk-heading-l">Account Update</h1>

{% if errors %}
  {{ govukErrorSummary({
    titleText: "There is a problem",
    errorList: errors
  }) }}
{% endif %}

{% if data %}
<form action="/accounts/update/{{ data.account.accountId }}" method="post" novalidate>
  <input type="hidden" name="accountRowVersion" value="{{ data.account.rowVersion }}">
  <input type="hidden" name="customerRowVersion" value="{{ data.customer.rowVersion }}">

  <div class="govuk-inset-text">
    Updating account <strong class="cd-mono">{{ data.account.accountId }}</strong>
  </div>

  <h2 class="govuk-heading-m">Account Information</h2>
  <div class="cd-form-grid">

    {{ govukSelect({
      label: { text: "Account Status" },
      id: "accountStatus",
      name: "accountStatus",
      value: data.account.accountStatus,
      items: [
        { value: "ACTIVE",    text: "Active" },
        { value: "SUSPENDED", text: "Suspended" },
        { value: "CLOSED",    text: "Closed" }
      ]
    }) }}

    {{ govukDateInput({
      id: "expirationDate",
      namePrefix: "expirationDate",
      fieldset: {
        legend: { text: "Expiration Date" }
      },
      hint: { text: "For example, 27 3 2028" },
      items: [
        {
          name: "day",
          id: "expirationDate-day",
          classes: "govuk-input--width-2",
          value: data.account.expirationDate | replace(r/^(\d{4})-(\d{2})-(\d{2})$/, "$3") if data.account.expirationDate
        },
        {
          name: "month",
          id: "expirationDate-month",
          classes: "govuk-input--width-2",
          value: data.account.expirationDate | replace(r/^(\d{4})-(\d{2})-(\d{2})$/, "$2") if data.account.expirationDate
        },
        {
          name: "year",
          id: "expirationDate-year",
          classes: "govuk-input--width-4",
          value: data.account.expirationDate | replace(r/^(\d{4})-(\d{2})-(\d{2})$/, "$1") if data.account.expirationDate
        }
      ]
    }) }}

    {{ govukInput({
      label: { text: "Credit Limit (£)" },
      id: "creditLimit",
      name: "creditLimit",
      classes: "govuk-input--width-10",
      type: "number",
      value: data.account.creditLimit,
      prefix: { text: "£" },
      attributes: { step: "0.01", min: "0" }
    }) }}

    {{ govukInput({
      label: { text: "Cash Credit Limit (£)" },
      id: "cashCreditLimit",
      name: "cashCreditLimit",
      classes: "govuk-input--width-10",
      type: "number",
      value: data.account.cashCreditLimit,
      prefix: { text: "£" },
      attributes: { step: "0.01", min: "0" }
    }) }}

  </div>

  <hr class="cd-section-divider">
  <h2 class="govuk-heading-m">Customer Information</h2>
  <div class="cd-form-grid">

    {{ govukInput({ label: { text: "First Name" }, id: "firstName", name: "firstName", value: data.customer.firstName, attributes: { required: "" } }) }}
    {{ govukInput({ label: { text: "Last Name" },  id: "lastName",  name: "lastName",  value: data.customer.lastName,  attributes: { required: "" } }) }}
    {{ govukInput({ label: { text: "Address Line 1" }, id: "addressLine1", name: "addressLine1", value: data.customer.addressLine1 }) }}
    {{ govukInput({ label: { text: "City" },  id: "city",  name: "city",  value: data.customer.city }) }}
    {{ govukInput({ label: { text: "State" }, id: "state", name: "state", value: data.customer.state, classes: "govuk-input--width-5" }) }}
    {{ govukInput({ label: { text: "ZIP Code" }, id: "zip", name: "zip", value: data.customer.zip, classes: "govuk-input--width-10" }) }}
    {{ govukInput({ label: { text: "Phone 1" }, id: "phone1", name: "phone1", value: data.customer.phone1, classes: "govuk-input--width-20", inputmode: "tel" }) }}
    {{ govukInput({ label: { text: "Phone 2 (optional)" }, id: "phone2", name: "phone2", value: data.customer.phone2, classes: "govuk-input--width-20", inputmode: "tel" }) }}

  </div>

  {{ govukRadios({
    name: "primaryCardHolderIndicator",
    fieldset: { legend: { text: "Primary Card Holder?", classes: "govuk-fieldset__legend--s" } },
    value: data.customer.primaryCardHolderIndicator,
    classes: "govuk-radios--inline",
    items: [
      { value: "Y", text: "Yes" },
      { value: "N", text: "No" }
    ]
  }) }}

  <div class="cd-action-group">
    {{ govukButton({ text: "Save Changes" }) }}
    <a href="/accounts/inquiry" class="govuk-link">Cancel</a>
  </div>

</form>
{% else %}
<p class="govuk-body">No account data available.</p>
{{ govukButton({ text: "Search for an account", href: "/accounts/inquiry", classes: "govuk-button--secondary" }) }}
{% endif %}

{% endblock %}
