{% extends "layouts/base.njk" %}
{% from "components/back-link/macro.njk"     import govukBackLink %}
{% from "components/radios/macro.njk"        import govukRadios %}
{% from "components/date-input/macro.njk"    import govukDateInput %}
{% from "components/button/macro.njk"        import govukButton %}
{% from "components/error-summary/macro.njk" import govukErrorSummary %}

{% block backLink %}
  {{ govukBackLink({ text: "Back to menu", href: "/menu" }) }}
{% endblock %}

{% block content %}

<span class="cd-page-caption">Reporting</span>
<h1 class="govuk-heading-l">Report Request</h1>

{% if result %}

<div class="govuk-panel govuk-panel--confirmation">
  <h1 class="govuk-panel__title">Request Submitted</h1>
  <div class="govuk-panel__body">
    Request ID<br>
    <strong>{{ result.requestId }}</strong>
  </div>
</div>

<h2 class="govuk-heading-m">Request Details</h2>
<dl class="govuk-summary-list">
  <div class="govuk-summary-list__row">
    <dt class="govuk-summary-list__key">Report Type</dt>
    <dd class="govuk-summary-list__value">
      <strong class="govuk-tag govuk-tag--blue">{{ result.reportType }}</strong>
    </dd>
  </div>
  <div class="govuk-summary-list__row">
    <dt class="govuk-summary-list__key">Date Range</dt>
    <dd class="govuk-summary-list__value">{{ result.resolvedStartDate }} to {{ result.resolvedEndDate }}</dd>
  </div>
  <div class="govuk-summary-list__row">
    <dt class="govuk-summary-list__key">Status</dt>
    <dd class="govuk-summary-list__value">
      <strong class="govuk-tag govuk-tag--blue">{{ result.status }}</strong>
    </dd>
  </div>
  <div class="govuk-summary-list__row">
    <dt class="govuk-summary-list__key">Request ID</dt>
    <dd class="govuk-summary-list__value cd-mono">{{ result.requestId }}</dd>
  </div>
</dl>

<div class="cd-action-group">
  {{ govukButton({ text: "Submit Another Request", href: "/reports/requests", classes: "govuk-button--secondary" }) }}
</div>

{% else %}

{% if errors %}
  {{ govukErrorSummary({ titleText: "There is a problem", errorList: errors }) }}
{% endif %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <form action="/reports/requests" method="post" novalidate>

      {% set customDatesHtml %}
        <div class="cd-form-grid">
          {{ govukDateInput({
            id: "startDate",
            namePrefix: "startDate",
            fieldset: { legend: { text: "Start Date" } },
            hint: { text: "For example, 1 6 2026" },
            items: [
              { name: "day",   id: "startDate-day",   classes: "govuk-input--width-2", value: formData["startDate-day"]   or "" },
              { name: "month", id: "startDate-month", classes: "govuk-input--width-2", value: formData["startDate-month"] or "" },
              { name: "year",  id: "startDate-year",  classes: "govuk-input--width-4", value: formData["startDate-year"]  or "" }
            ]
          }) }}

          {{ govukDateInput({
            id: "endDate",
            namePrefix: "endDate",
            fieldset: { legend: { text: "End Date" } },
            hint: { text: "For example, 30 6 2026" },
            items: [
              { name: "day",   id: "endDate-day",   classes: "govuk-input--width-2", value: formData["endDate-day"]   or "" },
              { name: "month", id: "endDate-month", classes: "govuk-input--width-2", value: formData["endDate-month"] or "" },
              { name: "year",  id: "endDate-year",  classes: "govuk-input--width-4", value: formData["endDate-year"]  or "" }
            ]
          }) }}
        </div>
      {% endset %}

      {{ govukRadios({
        name: "reportType",
        idPrefix: "reportType",
        fieldset: {
          legend: {
            text: "Report Type",
            classes: "govuk-fieldset__legend--s"
          }
        },
        hint: { text: "Select the reporting period" },
        value: formData.reportType,
        items: [
          {
            value: "MONTHLY",
            text: "Monthly",
            hint: { text: "Current calendar month" }
          },
          {
            value: "YEARLY",
            text: "Yearly",
            hint: { text: "Current calendar year" }
          },
          { divider: "or" },
          {
            value: "CUSTOM",
            text: "Custom date range",
            conditional: { html: customDatesHtml }
          }
        ]
      }) }}

      <hr class="cd-section-divider">

      {{ govukRadios({
        name: "confirmation",
        fieldset: { legend: { text: "Confirmation", classes: "govuk-fieldset__legend--s" } },
        hint: { text: "Confirm you want to submit this report request" },
        value: formData.confirmation,
        classes: "govuk-radios--inline",
        items: [
          { value: "Y", text: "Yes, submit this report" },
          { value: "N", text: "No" }
        ]
      }) }}

      <div class="cd-action-group">
        {{ govukButton({ text: "Submit Request" }) }}
        <a href="/menu" class="govuk-link">Cancel</a>
      </div>

    </form>
  </div>
</div>
{% endif %}

{% endblock %}
