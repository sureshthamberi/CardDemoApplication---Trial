{% extends "layouts/base.njk" %}
{% from "components/back-link/macro.njk"     import govukBackLink %}
{% from "components/input/macro.njk"         import govukInput %}
{% from "components/button/macro.njk"        import govukButton %}
{% from "components/error-summary/macro.njk" import govukErrorSummary %}

{% block backLink %}
  {{ govukBackLink({ text: "Back to admin", href: "/admin/transaction-types" }) }}
{% endblock %}

{% block content %}

<span class="cd-page-caption">Administration — Reference Data</span>
<h1 class="govuk-heading-l">{{ 'Add Transaction Type' if mode == 'add' else 'Edit Transaction Type' }}</h1>

{% if errors %}
  {{ govukErrorSummary({ titleText: "There is a problem", errorList: errors }) }}
{% endif %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <form action="/admin/transaction-types/{{ 'add' if mode == 'add' else (formData.typeCode + '/edit') }}" method="post" novalidate>
      {% if mode == 'edit' %}
      <input type="hidden" name="rowVersion" value="{{ formData.rowVersion }}">
      {% endif %}

      {{ govukInput({
        label: { text: "Type Code", classes: "govuk-label--s" },
        hint: { text: "Unique identifier — uppercase letters and underscores (e.g. CASH_ADV)" if mode == 'add' else "Type code cannot be changed" },
        id: "typeCode",
        name: "typeCode",
        classes: "govuk-input--width-20",
        value: formData.typeCode or "",
        attributes: { required: "", readonly: "" if mode == 'edit', style: "background:#f3f2f1;color:#505a5f;" if mode == 'edit' }
      }) }}

      {{ govukInput({
        label: { text: "Description", classes: "govuk-label--s" },
        id: "description",
        name: "description",
        value: formData.description or "",
        attributes: { required: "", maxlength: "255" }
      }) }}

      <div class="cd-action-group">
        {{ govukButton({ text: "Create Type" if mode == 'add' else "Update Type" }) }}
        <a href="/admin/transaction-types" class="govuk-link">Cancel</a>
      </div>
    </form>
  </div>
</div>

{% endblock %}
