{% extends "layouts/base.njk" %}
{% from "components/back-link/macro.njk" import govukBackLink %}
{% from "components/button/macro.njk"    import govukButton %}

{% block backLink %}
  {{ govukBackLink({ text: "Back to admin menu", href: "/menu/admin" }) }}
{% endblock %}

{% block content %}

<span class="cd-page-caption">Administration — Reference Data</span>
<h1 class="govuk-heading-l">Transaction Type Maintenance</h1>

<div class="cd-action-group govuk-!-margin-bottom-4">
  {{ govukButton({ text: "Add Type", href: "/admin/transaction-types/add" }) }}
</div>

{% if data and data.items.length %}
<div class="cd-table-wrapper">
  <table class="govuk-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th class="govuk-table__header">Type Code</th>
        <th class="govuk-table__header">Description</th>
        <th class="govuk-table__header">Version</th>
        <th class="govuk-table__header">Actions</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for type in data.items %}
      <tr class="govuk-table__row">
        <td class="govuk-table__cell">
          <strong class="govuk-tag govuk-tag--blue">{{ type.typeCode }}</strong>
        </td>
        <td class="govuk-table__cell">{{ type.description }}</td>
        <td class="govuk-table__cell">{{ type.rowVersion }}</td>
        <td class="govuk-table__cell cd-table-actions">
          <a href="/admin/transaction-types/{{ type.typeCode }}/edit" class="govuk-link">Edit</a>
          <a href="/admin/transaction-types/{{ type.typeCode }}/delete" class="govuk-link govuk-link--danger">Delete</a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<div class="govuk-inset-text">No transaction types found.</div>
{% endif %}

{% endblock %}
